__pycache__/
bulletins.db
# SQLite's write-ahead log and shared-memory sidecars. Live runtime
# state of one node, recreated on demand, and meaningless anywhere
# else -- they appear whenever the BBS is running.
bulletins.db-shm
bulletins.db-wal
js8call.db
venv/
.venv
.idea
config.ini
fortunes.txt
meshtastic-web/
meshtastic-web-dist/
bbs-recent.log
*.log


# Uploaded MQTT TLS material (may contain PRIVATE KEYS) -- never commit.
# Nodes are updated by `git pull`, so a tracked key would propagate.
data/mqtt-certs/

# Generated once by the SSH service. Back it up outside Git; it is the server
# identity clients trust and must never be propagated as a shared private key.
data/ssh_host_key
data/ssh_host_key.pub

# Runtime IPC trigger files written by the web admin for server.py to
# consume (manual sync, reconnect, links reload). Transient, never source.
*.trigger
.manual_sync_trigger

# Live link/sync snapshot server.py rewrites on every main-loop pass
# (write_runtime_diagnostics_snapshot) for the web admin to read. Machine
# state of one node, regenerated on the next tick -- committing it would
# push one node's momentary status onto every other node on `git pull`.
runtime_diagnostics.json

# Generated by version_info: the commit count this install last resolved.
# Deliberately NOT committed -- a committed count changes on every commit,
# which changes the count. It is regenerated on any run that can read git.
_build_version.py
