[Unit]
Description=BACON BBS Web Admin GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/web-admin.env
Environment="BBS_WEBGUI_HOST=0.0.0.0"
Environment="BBS_WEBGUI_PORT=8081"
ExecStart=__PROJECT_DIR__/venv/bin/python3 __PROJECT_DIR__/web_admin.py

[Install]
WantedBy=multi-user.target
